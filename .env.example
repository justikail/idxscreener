# Salin file ini menjadi .env.local lalu isi nilai sesuai lingkungan Anda.

# Koneksi PostgreSQL. Default mengarah ke docker-compose lokal (lihat docker-compose.yml).
# Docker bukan keharusan: Anda bisa mengarahkan ke PostgreSQL eksternal mana pun.
DATABASE_URL="postgresql://ihsg:ihsg@localhost:5432/ihsg_screener"

# Mode tampilan web: "live" = hanya data real, "demo" = hanya data demo, kosong = keduanya (berlabel).
DATA_MODE="demo"

# Secret session/auth. Wajib diisi sebelum M2 (fitur auth) diaktifkan. Jangan commit nilai asli.
AUTH_SECRET="ganti-dengan-nilai-acak-panjang"

# Base URL aplikasi (dipakai oleh auth/callback bila diperlukan).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Arjum (sumber data utama). API key dari Developer Dashboard -> API Keys
# (format sk_live_...). Hanya untuk server: JANGAN pakai awalan NEXT_PUBLIC_,
# jangan commit, jangan tempel ke chat/log. Token sesi login web (JWT) TIDAK
# cocok: kedaluwarsa ~7 hari.
ARJUM_API_KEY=""
# Budget request harian aplikasi untuk SEMUA request Arjum (OHLCV + dataset
# tambahan). Dipotong otomatis ke ARJUM_ACCOUNT_QUOTA (kuota satu akun, FREE
# 1.000/hari gabungan semua key) — tidak pernah dinaikkan otomatis. Kosong = 990.
ARJUM_DAILY_BUDGET="990"
# Kuota resmi satu akun. Ubah HANYA bila paket resmi berubah.
ARJUM_ACCOUNT_QUOTA="1000"
# Hanya SATU key dipakai (tanpa rotasi). ARJUM_API_KEYS lama: key pertama saja.

# Hosting (lihat docs/deploy.md). "github-actions" bila job data dijalankan oleh
# workflow .github/workflows/data-jobs.yml (Vercel), kosongkan untuk worker lokal.
SCHEDULER=""
