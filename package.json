{
  "name": "ihsg-screener",
  "private": true,
  "packageManager": "pnpm@12.4.2",
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude \"tests/integration/**\"",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/server/db/migrate.ts",
    "db:seed": "tsx src/jobs/seed.ts",
    "db:seed-users": "tsx src/jobs/seed-users.ts",
    "users:set-password": "tsx src/jobs/set-password.ts",
    "jobs:run": "tsx src/jobs/run.ts",
    "jobs:daily": "tsx src/jobs/daily-update.ts",
    "jobs:tick": "tsx src/jobs/tick.ts",
    "jobs:universe": "tsx src/jobs/universe.ts",
    "jobs:evaluate-alerts": "tsx src/jobs/evaluate-alerts.ts",
    "ingest:idx": "tsx src/jobs/ingest-idx-daily.ts",
    "arjum:probe": "tsx src/jobs/arjum-probe.ts",
    "audit:arjum": "tsx src/jobs/arjum-capacity-audit.ts",
    "audit:arjum:report": "tsx src/jobs/arjum-capacity-report.ts",
    "ingest:arjum": "tsx src/jobs/ingest-arjum.ts",
    "worker": "tsx src/jobs/worker.ts",
    "worker:loop": "bash scripts/worker-loop.sh",
    "jobs:backfill-foreign": "tsx src/jobs/backfill-foreign.ts",
    "arjum:probe-extended": "tsx src/jobs/arjum-probe-extended.ts",
    "jobs:replay-probe": "tsx src/jobs/replay-probe.ts"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "drizzle-orm": "^0.36.4",
    "lightweight-charts": "^5.2.1",
    "next": "^15.1.3",
    "next-auth": "5.0.0-beta.25",
    "postgres": "^3.4.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@playwright/test": "^1.49.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "dotenv": "^16.4.7",
    "drizzle-kit": "^0.30.1",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.3",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
